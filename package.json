{
  "name": "dsh-better-workspace-file-manager",
  "version": "1.3.0",
  "description": "Better workspace file manager for DeepSeek Harness: upload, multi-select, ZIP download, new folder, delete, drag-to-move, drag-to-chat, and in-place text editing for the Files tab and file previews.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "file-manager",
    "files",
    "upload",
    "download"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arrosam/dsh-better-workspace-file-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Arrosam/dsh-better-workspace-file-manager/issues"
  },
  "homepage": "https://github.com/Arrosam/dsh-better-workspace-file-manager#readme",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-open-in-app",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
