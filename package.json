{
  "name": "dsh-better-workspace-file-manager",
  "version": "1.1.0",
  "private": true,
  "description": "Upload (button or drag-and-drop), multi-select download, new folder, delete, drag-to-move, and drag-to-chat for the workspace Files tab.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-files"
      ]
    }
  }
}
